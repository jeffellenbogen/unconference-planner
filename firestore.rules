rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // Only these verified accounts can create events. Keep in sync with
    // ORGANIZER_EMAILS in js/config.js (that copy only adjusts the UI).
    function isOrganizerAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['jellenbogen@dawsonschool.org'];
    }
    function eventData(eid) {
      return get(/databases/$(database)/documents/events/$(eid)).data;
    }
    function isAdmin(eid) {
      return signedIn() && request.auth.uid in eventData(eid).adminUids;
    }

    match /events/{eid} {
      allow read: if signedIn();
      allow create: if isOrganizerAccount() && request.auth.uid in request.resource.data.adminUids;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.adminUids;

      // One doc per participant; only they (or an organizer) can write it.
      match /participants/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin(eid));
        allow delete: if isAdmin(eid);
      }

      // Participants can post ideas during Phase 1, and +1 / offer to lead / comment anytime.
      match /ideas/{iid} {
        allow read: if signedIn();
        allow create: if isAdmin(eid)
          || (signedIn()
              && request.resource.data.authorUid == request.auth.uid
              && eventData(eid).phase == 'ideas');
        allow update: if isAdmin(eid)
          || (signedIn()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'leads', 'comments']));
        allow delete: if isAdmin(eid);
      }

      match /sessions/{sid} {
        allow read: if signedIn();
        allow write: if isAdmin(eid);
      }
    }
  }
}
